<?xml version="1.0" encoding="utf-8"?>
<!--
  深色模式主题，逐项对应 values/themes.xml（样式不跨配置合并，这里必须写全）。
  与浅色模式的差别只有 windowLightStatusBar 一项：深色底板上要白图标。
-->
<resources>
    <style name="Theme.SportsWidget" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_widget</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_widget</item>
        <item name="android:statusBarColor">@color/bg_widget</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/nav_bar</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
