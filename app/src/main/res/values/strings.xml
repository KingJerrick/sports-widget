    <!-- App 段落标题 -->
    <string name="app_title">赛事日历</string>
    <string name="section_schedule">① 未来七天赛程</string>
    <string name="section_legend">② 颜色图例</string>
    <string name="section_sources">③ 数据源状态</string>
    <string name="section_icons">④ 卡片图标</string>
    <string name="section_settings">⑤ 设置</string>

    <string name="legend_hint">小组件上每场比赛是一张卡片：左边是图标，右边是「哪一站什么比赛」。一个比赛周末合成一张卡（F1 西班牙站的 FP1/FP2/排位/正赛是同一张），棒球则是一个系列赛合成一张卡。往下滑看更多。顶部那排小字是七天概览，有比赛的日子有底色。</string>
    <string name="legend_state_hint">卡片底色表示状态，越暗越接近结束：未开始最亮，比赛中居中，已结束最暗。已结束的卡片会置顶，右侧显示比分 / 系列赛战绩 / 分站冠军，只保留 24 小时内的。「比赛中」是按开赛时刻加一个典型时长估的，不看实际什么时候结束。</string>

    <string name="icons_hint">给每个分组传一张图，会显示在卡片左侧。建议用正方形、图案清晰的图（透明底 PNG 最好）。不上传就用下面的字母块。</string>
    <string name="btn_pick_image">选图</string>
    <string name="btn_clear_image">清除</string>
    <string name="crop_title">调整图标</string>
    <string name="crop_hint">拖动挪位置，双指缩放。框里看到的就是卡片上会显示的。</string>
    <string name="crop_ok">就用这张</string>
    <string name="crop_reset">重置</string>
    <string name="icon_letter_prefix">字母块</string>
    <string name="icon_uploaded">已上传</string>
    <string name="toast_image_bad">这张图读不出来，换一张试试</string>
    <string name="toast_image_saved">已保存，小组件上的图标已更新</string>

    <string name="label_endpoint">自定义数据地址（留空用默认）</string>
    <string name="hint_endpoint">https://…/calendar.json</string>
    <string name="interval_label">小组件刷新间隔</string>

    <string name="label_gh_token">GitHub token（触发抓取用，可留空）</string>
    <string name="hint_gh_token">github_pat_…</string>
    <string name="note_gh_token">建一个 fine-grained PAT，只授权这个仓库、只勾 Actions 的读写权限。它只存在这台手机上，不会进仓库、也不会打进 APK。留空的话「刷新」照常能用，只是拉到的还是后端上一次抓的那份。</string>

