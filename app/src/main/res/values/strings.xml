    <!--
      小组件顶栏那两个按键。刻意都用动词、都只有两个字，宽度才好对齐 ——
      它们一左一右摆在顶栏两端，宽窄不一会让中间那条七天迷你条左右晃。
    -->
    <string name="action_refresh">刷新</string>
    <string name="action_trigger">抓取</string>

    <!-- 小组件顶栏状态行。这两句是点完按键的即时反馈，Worker 跑完就被结果覆盖 -->
    <string name="status_refreshing">刷新中…</string>
    <string name="status_triggering">触发中…</string>
    <string name="status_never">尚未获取数据，点此设置</string>

