<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件在选择器里的预览图，给 **API 31 以下**用
  （31+ 走 widget_info.xml 的 previewLayout，指向 widget_sports_preview.xml）。

  为什么 31 以下要单独给一张图：previewLayout / description / targetCell* 全是
  API 31 才生效的属性，31 以下的启动器只认 previewImage，缺了它选择器里就是
  一个默认的安卓图标 —— 没人会拖。

  这是一张静态矢量图，按 250×110 的实际比例画（viewport 就取这个值），
  内容照着小组件现在的样子摆：顶栏 + 七天迷你条 + 三张卡片。

  改布局时这张图也要跟着改，否则预览和实际长得不一样。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="250dp"
    android:height="110dp"
    android:viewportWidth="250"
    android:viewportHeight="110">

    <!-- 底板 -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M0,0 h250 v110 h-250 z" />

    <!-- ── 顶栏：品牌竖条 + 七天迷你条 + 状态 + 刷新 ── -->
    <path android:fillColor="#FF334155" android:pathData="M9,5 h3 v11 h-3 z" />
    <!-- 七天条：第 1/2/3/4/7 格有比赛（填底色），其余空着 -->
    <path android:fillColor="#FFE2E8F0" android:pathData="M18,6 h18 v11 h-18 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M38,6 h18 v11 h-18 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M58,6 h18 v11 h-18 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M78,6 h18 v11 h-18 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M138,6 h18 v11 h-18 z" />
    <!-- 状态：数据生成时间 -->
    <path android:fillColor="#FF94A3B8" android:pathData="M166,9 h42 v6 h-42 z" />
    <!-- 刷新 -->
    <path android:fillColor="#FF334155" android:pathData="M222,7 h8 v8 h-8 z" />

    <!-- ── 卡片 1：F1 ── -->
    <path android:fillColor="#FFF8FAFC" android:pathData="M8,24 h234 v34 h-234 z" />
    <path android:fillColor="#FFC8102E" android:pathData="M12,27 h28 v28 h-28 z" />
    <path android:fillColor="#FF334155" android:pathData="M48,30 h92 v6 h-92 z" />
    <path android:fillColor="#FF94A3B8" android:pathData="M196,31 h38 v5 h-38 z" />
    <path android:fillColor="#FFCBD5E1" android:pathData="M48,42 h128 v5 h-128 z" />

    <!-- ── 卡片 2：MotoGP ── -->
    <path android:fillColor="#FFF8FAFC" android:pathData="M8,62 h234 v34 h-234 z" />
    <path android:fillColor="#FFC2410C" android:pathData="M12,65 h28 v28 h-28 z" />
    <path android:fillColor="#FF334155" android:pathData="M48,68 h104 v6 h-104 z" />
    <path android:fillColor="#FF94A3B8" android:pathData="M196,69 h38 v5 h-38 z" />
    <path android:fillColor="#FFCBD5E1" android:pathData="M48,80 h146 v5 h-146 z" />

    <!-- ── 卡片 3：IG（只露出上半截，暗示下面还能滑）── -->
    <path android:fillColor="#FFF8FAFC" android:pathData="M8,100 h234 v10 h-234 z" />
    <path android:fillColor="#FF1D4ED8" android:pathData="M12,103 h28 v7 h-28 z" />
    <path android:fillColor="#FF334155" android:pathData="M48,104 h112 v6 h-112 z" />
</vector>
