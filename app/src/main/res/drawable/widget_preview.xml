<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件在选择器里的预览图，给 **API 31 以下**用
  （31+ 走 widget_info.xml 的 previewLayout，指向 widget_sports_preview.xml）。

  为什么 31 以下要单独给一张图：previewLayout / description / targetCell* 全是
  API 31 才生效的属性，31 以下的启动器只认 previewImage，缺了它选择器里就是
  一个默认的安卓图标 —— 没人会拖。

  这是一张静态矢量图，按 250×110 的实际比例画（viewport 就取这个值），
  内容照着小组件现在的样子摆：顶栏（刷新 + 品牌竖条 + 七天条 + 状态 + 抓取）
  + 两张多一点卡片。

  形状全用直角矩形，不画圆角 —— 卡片实际是 8dp 圆角、按键是 6dp 圆角，但这是
  选择器里的缩略图，圆角在这个尺寸上看不出来，画了只是让路径难读。

  改布局时这张图也要跟着改，否则预览和实际长得不一样。
  这里没有文字（矢量图里画不了字），两个按键用一小条深色横杠示意文字。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="250dp"
    android:height="110dp"
    android:viewportWidth="250"
    android:viewportHeight="110">

    <!-- 底板 -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M0,0 h250 v110 h-250 z" />

    <!-- ── 顶栏（y 9~31，即根内边距 8dp 之后的 24dp）── -->

    <!-- 刷新按键：底、以及示意文字的一小条 -->
    <path android:fillColor="#FFE2E8F0" android:pathData="M8,9 h32 v22 h-32 z" />
    <path android:fillColor="#FF334155" android:pathData="M16,18 h16 v4 h-16 z" />

    <!-- 品牌竖条 -->
    <path android:fillColor="#FF334155" android:pathData="M46,14.5 h3 v11 h-3 z" />

    <!-- 七天条：第 1/2/3/4/7 格有比赛（填底色），其余空着 -->
    <path android:fillColor="#FFE2E8F0" android:pathData="M55,14.5 h13 v11 h-13 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M70,14.5 h13 v11 h-13 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M85,14.5 h13 v11 h-13 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M100,14.5 h13 v11 h-13 z" />
    <path android:fillColor="#FFE2E8F0" android:pathData="M130,14.5 h13 v11 h-13 z" />

    <!-- 状态：数据生成时间 -->
    <path android:fillColor="#FF94A3B8" android:pathData="M166,17.5 h39 v6 h-39 z" />

    <!-- 抓取按键 -->
    <path android:fillColor="#FFE2E8F0" android:pathData="M210,9 h32 v22 h-32 z" />
    <path android:fillColor="#FF475569" android:pathData="M218,18 h16 v4 h-16 z" />

    <!-- ── 卡片 1：F1（列表从 y 35 开始，顶栏 31 + 间距 4）── -->
    <path android:fillColor="#FFF8FAFC" android:pathData="M8,35 h234 v34 h-234 z" />
    <path android:fillColor="#FFC8102E" android:pathData="M12,38 h28 v28 h-28 z" />
    <path android:fillColor="#FF334155" android:pathData="M48,41 h92 v6 h-92 z" />
    <path android:fillColor="#FF94A3B8" android:pathData="M196,42 h38 v5 h-38 z" />
    <path android:fillColor="#FFCBD5E1" android:pathData="M48,53 h128 v5 h-128 z" />

    <!-- ── 卡片 2：MotoGP（顶栏变高之后 4×2 只能完整看到一张多，
         所以这张画到 110 处被裁掉 —— 预览要和实际一样，不能为了让图好看
         就多塞一张，那会让人拖上桌面才发现卡片露不全）── -->
    <path android:fillColor="#FFF8FAFC" android:pathData="M8,73 h234 v34 h-234 z" />
    <path android:fillColor="#FFC2410C" android:pathData="M12,76 h28 v28 h-28 z" />
    <path android:fillColor="#FF334155" android:pathData="M48,79 h104 v6 h-104 z" />
    <path android:fillColor="#FF94A3B8" android:pathData="M196,80 h38 v5 h-38 z" />
    <path android:fillColor="#FFCBD5E1" android:pathData="M48,91 h146 v5 h-146 z" />
</vector>
