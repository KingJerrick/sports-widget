<?xml version="1.0" encoding="utf-8"?>
<!--
  赛事条（chip）的背景。5 个类别各一份，内容完全一样，只有 solid 指向的颜色不同。

  为什么要拆成 5 份而不是一份加运行时 tint：见 bg_dot.xml 的说明 ——
  RemoteViews 的运行时着色是 API 31+ 才可靠的东西，minSdk 26 上会直接抛异常、
  桌面显示「载入小组件时出现问题」。所以只能用 setBackgroundResource 切预置 drawable。

  solid 指向 @color/cat_f1，深浅两套值由资源系统自动选，代码不用管主题。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/cat_f1" />
    <corners android:radius="3dp" />
</shape>
