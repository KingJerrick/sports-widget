<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件底板。顶部到下部有一道很浅的渐变，给「纸面」一点光向；
  深色模式下是仪表盘的暗场。颜色走 @color/bg_widget_top / _bottom，深浅两套值在 values-night 里。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/bg_widget_bottom"
        android:startColor="@color/bg_widget_top"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/hairline" />
</shape>
