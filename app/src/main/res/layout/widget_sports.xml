<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 小组件布局（标称 250×110dp）：一条顶栏 + 一个可滚动的卡片列表。

  ══ 尺寸账（改字号、间距之前先看这段）══════════════════════════════════

    根 padding 上下 8*2                                       = 16
    顶栏（是 max(子 view)，刷新图标 18dp 撑出来的）             = 18
    顶栏 → 列表间距                                            =  4
    ───────────────────────────────────────────────────────────────
    固定部分合计                                               = 38
    列表区 layout_weight=1，吸收剩余：110 - 38 = 72dp

    一张卡片 38dp + 卡片间距 4dp = 42dp → **4×2 里可见约 1.7 张**。
    这不是排版没做好，是物理限制：卡片要放「图标 + 标题 + 时间 + 副标题」，
    38dp 已经是压到极限了。往下滑看其余，或者把小组件拖高 ——
    代码允许拖到 180dp，那时可见约 3.4 张。

  ══ 顶栏为什么把「标题」换成了「品牌竖条」════════════════════════════

  顶栏这一行要放四样东西：身份标识、七天迷你条、数据更新时间、刷新按钮。
  250dp 减掉左右内边距只有 234dp，写「赛事日历」四个字要 40dp，
  七天条就没地方了。换成 3dp 的竖条，身份还在（那一抹颜色就是），
  省下的宽度全给迷你条。

  ══ 可滚动是怎么实现的 ═══════════════════════════════════════════════

  安卓的小组件只有 ListView / GridView 这类「集合控件」能滚动，而且必须：

    · 布局里有一个 id 为 @android:id/list 的 ListView
    · 配一个 RemoteViewsService + RemoteViewsFactory 提供每一行
    · 用 setRemoteAdapter 把它接起来（见 WidgetRenderer）

  普通控件（TextView 之类）放在 ListView 外面没问题，所以顶栏这么放是合法的。

  ══ RemoteViews 三条红线（踩过的坑，别改）══════════════════════════

    1. 只用 LinearLayout / FrameLayout / TextView / ImageView / ListView 这些框架控件，
       裸 View 不用，**也不要用 AppCompat 的控件** —— AppCompat 覆写的方法不带
       @RemotableViewMethod 注解，反射调用会直接失败。
    2. 一律不写 ?attr/ —— 布局是在启动器的 Context 里 inflate 的。
    3. 字号一律用 dp 不用 sp（原因见 widget_card.xml）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ══ 顶栏：品牌竖条 + 七天迷你条 + 状态 + 刷新 ══════════════════ -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 品牌竖条。用 TextView 当色块，避免 RemoteViews 里出现裸 View -->
        <TextView
            android:layout_width="3dp"
            android:layout_height="11dp"
            android:background="@drawable/bg_mark"
            android:minHeight="0dp" />

        <!--
          七天迷你条：这七天里哪天有比赛。
          卡片流回答「比什么赛」，这条回答「哪天有比赛」—— 两个不同的问题。
          没有它的话一眼看过去完全不知道哪天是空的。

          每格文字是「今 / 六 / 日 / 一 …」，有比赛的日子加一层底色（bg_daychip_on）。
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:layoutDirection="ltr"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_day_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_daychip_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/tv_day_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_daychip_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/tv_day_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_daychip_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/tv_day_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_daychip_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/tv_day_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_daychip_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/tv_day_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_daychip_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="9dp" />

            <TextView
                android:id="@+id/tv_day_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_daychip_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="9dp" />
        </LinearLayout>

        <!--
          状态行。显示**数据生成时间**而不是手机拉取时间 —— 后端定时抓取挂掉时，
          手机照样能成功拉到同一份旧数据，显示拉取时间的话「后端停了」会被完全掩盖。
          超过 24 小时未更新会转琥珀色。见 WidgetRenderer.applyStatus。
        -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textColor="@color/text_muted"
            android:textSize="9dp" />

        <!-- 刷新图标只有 18dp，低于 48dp 的最小触控区，所以点击事件挂在整条顶栏上 -->
        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_refresh"
            android:padding="3dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <!-- ══ 卡片列表（可滚动）══════════════════════════════════════════ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <!--
          ListView 的 id 必须是 @android:id/list，系统靠它认出这是个集合控件。
        -->
        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@color/transparent"
            android:divider="@color/transparent"
            android:dividerHeight="4dp"
            android:drawSelectorOnTop="true"
            android:scrollbars="none" />

        <!-- 一张卡都没有时显示。靠 setEmptyView 自动切换显隐，不用手写逻辑 -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/empty_schedule"
            android:textColor="@color/text_muted"
            android:textSize="10dp" />
    </FrameLayout>
</LinearLayout>
