<?xml version="1.0" encoding="utf-8"?>
<!--
  配置页 / 赛程页。

  静态骨架写在这里，动态内容（赛程行、图例行、数据源状态行）由 MainActivity 填进
  那几个容器里 —— 它们的条数取决于数据，写不进 XML。

  段落用 ① ② ③ ④ 带圈数字小标题，沿用 deepseek-widget 配置页的排版风格。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_widget"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- ① 未来七天赛程 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_schedule" />

        <LinearLayout
            android:id="@+id/box_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ② 颜色图例 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_legend" />

        <LinearLayout
            android:id="@+id/box_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/legend_hint"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- 卡片底色那三档的含义。放在图例后面是因为它讲的也是「颜色代表什么」，
             只不过上面是类别色、这条是状态色。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/legend_state_hint"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- ③ 数据源状态 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_sources" />

        <LinearLayout
            android:id="@+id/box_sources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ④ 卡片图标（用户自己上传） -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_icons" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/icons_hint"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/box_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ⑤ 设置 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_endpoint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_endpoint"
            android:inputType="textUri"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/interval_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/sp_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!--
          GitHub token。留空就只是不启用「手动触发抓取」，其余功能不受影响 ——
          所以这里没有任何必填校验。说明写进 hint 和下面的小字，
          因为它不是一看就懂的东西（要建 fine-grained PAT、要勾 Actions 读写）。
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_gh_token"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/et_gh_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/hint_gh_token"
            android:inputType="textPassword"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/note_gh_token"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <!--
          三个按键各干一件事，边界是「联网做什么」：
            保存 —— 不联网，只写设置 + 按新间隔重排周期任务
            刷新 —— 联网 GET 一份现成的 calendar.json，不碰 Actions
            测试 —— 联网 GET 一次，但只报告不落库
          要更新的数据得先点下面的「触发抓取」再去点「刷新」，见 README。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/accent"
                android:text="@string/btn_save"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_card"
                android:text="@string/btn_refresh_now"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btn_test"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_card"
                android:text="@string/btn_test"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_trigger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/bg_card"
            android:text="@string/btn_trigger"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
